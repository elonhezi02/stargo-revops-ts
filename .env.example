PORT=3002
DATABASE_PATH=runtime/revops.sqlite
LLM_PROVIDER=rules
OLLAMA_MODEL=qwen3:4b-instruct
LLM_TIMEOUT_MS=30000

# Provider-neutral overrides (OLLAMA_MODEL remains a supported legacy alias).
# LLM_MODEL=qwen3:4b-instruct
# LLM_ENDPOINT=http://127.0.0.1:11434/api/chat
# For a local server supporting Chat Completions with JSON schema:
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=your-loaded-model
# LLM_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
