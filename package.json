{
  "name": "stargo-revops-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run format:check",
    "format": "prettier --write client server shared scripts tests *.ts *.json",
    "format:check": "prettier --check client server shared scripts tests *.ts *.json",
    "export:kpi": "tsx scripts/export.ts",
    "test:live": "tsx scripts/live.ts",
    "package": "node scripts/package.mjs",
    "model:serve": "node scripts/model.mjs serve",
    "model:pull": "node scripts/model.mjs pull"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "luxon": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
